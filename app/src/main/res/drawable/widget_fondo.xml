<?xml version="1.0" encoding="utf-8"?>
<!-- Il tabellone del disegno: bordo di 2dp, poi una cornice interna di 4dp, poi il nero (o la carta). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_cornice" />
            <stroke android:width="2dp" android:color="@color/widget_bordo" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_fondo" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
