<?xml version="1.0" encoding="utf-8"?>
<!-- Widget tabellone: la preferita a cui sei vicino, con le sole linee fissate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/testata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/etichetta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_tenue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:textColor="@color/widget_accento"
            android:textSize="17sp" />

        <ImageView
            android:id="@+id/aggiorna"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:src="@drawable/ic_aggiorna" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:background="@color/widget_divisore" />

    <LinearLayout
        android:id="@+id/righe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
    <LinearLayout
        android:id="@+id/riga1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="42dp">

            <ImageView
                android:id="@+id/fondo1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_badge" />

            <TextView
                android:id="@+id/linea1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/doto_nero"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="42dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/capolinea1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_testo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tra1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/riga2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="42dp">

            <ImageView
                android:id="@+id/fondo2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_badge" />

            <TextView
                android:id="@+id/linea2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/doto_nero"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="42dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/capolinea2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_testo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tra2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/riga3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:minWidth="42dp">

            <ImageView
                android:id="@+id/fondo3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_badge" />

            <TextView
                android:id="@+id/linea3"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/doto_nero"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="42dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/capolinea3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:textColor="@color/widget_testo"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tra3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="28sp" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:textColor="@color/widget_tenue"
        android:textSize="12sp" />
</LinearLayout>
