<?xml version="1.0" encoding="utf-8"?>
<!-- Widget piccolo (come nel disegno): "PIÙ VICINA", il nome con la distanza, due linee con i minuti. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo_semplice"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/etichetta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.104"
        android:maxLines="1"
        android:textColor="@color/widget_accento"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_testo"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/nota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_tenue"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/riga1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="36dp">

            <ImageView
                android:id="@+id/fondo1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_badge_piccolo" />

            <TextView
                android:id="@+id/linea1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/doto_nero"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="36dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/capolinea1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tra1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/riga2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="36dp">

            <ImageView
                android:id="@+id/fondo2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_badge_piccolo" />

            <TextView
                android:id="@+id/linea2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:fontFamily="@font/doto_nero"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="36dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/capolinea2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tra2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto_nero"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_accento"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
